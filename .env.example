# Buddha News environment variables
# =============================================================================
# Copy this file to `.env` for a local run and fill in the values. Never commit
# `.env`, and never bake secrets into a Docker image. On Manus hosting the
# platform injects DATABASE_URL and the MANUS_* values.
#
# Production boot refuses to start when a required value is missing or unsafe;
# see server/config.ts. Every variable below is read at runtime, so changing one
# only requires a restart.
# =============================================================================

# --- Required ---------------------------------------------------------------
# MySQL/MariaDB connection string. Use a dedicated, least-privilege account.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/buddhanews

# Signs the HttpOnly session cookie. Generate with:
#   openssl rand -base64 48
MANUS_JWT_SECRET=

# Exact public https origin readers use. REQUIRED in production and used for
# canonical links, hreflang, Open Graph, sitemap and RSS. The request Host
# header is never trusted for these values.
# Example: https://www.buddhanews.com
PUBLIC_SITE_URL=

# --- Manus OAuth (required for newsroom login on Manus hosting) -------------
# Required for newsroom OAuth login. The session verifier has a stable fallback
# audience ("buddhanews") when this is empty, but /api/oauth/start returns 503
# without a real project id. The platform normally supplies it.
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_OAUTH_PORTAL_URL=https://manus.ai
MANUS_API_URL=https://api.manus.ai
MANUS_API_KEY=

# --- Newsroom access --------------------------------------------------------
# Comma-separated, case-insensitive email allowlists. They are checked against
# the CURRENT account email on every request, so removing an address revokes
# access immediately. ADMIN_EMAILS grant the Admin role; EDITOR_EMAILS grant the
# Editor role (draft/edit only, no publish, delete, settings or subscriber PII).
ADMIN_EMAILS=
EDITOR_EMAILS=

# OpenID of the account that may change other users' roles. This is an
# environment-level owner identity, not a database role. If empty, no one can
# change roles until an operator sets it.
OWNER_OPEN_ID=

# --- Cookies and sessions ---------------------------------------------------
# Absolute session lifetime (hours, 1-720, default 12).
SESSION_TTL_HOURS=12
# Idle lifetime (hours, 1 to SESSION_TTL_HOURS, default 4).
SESSION_IDLE_HOURS=4
# Cookies are always Secure in production. Outside production they are Secure
# on HTTPS (honouring a trusted proxy) or when this is true.
COOKIE_SECURE=true
# Only enable when the browser and API are on different sites; this switches
# the session cookie to SameSite=None (requires HTTPS).
ALLOW_CROSS_SITE_COOKIES=false
# Optional cookie domain for subdomain sharing. Leave empty for host-only.
COOKIE_DOMAIN=

# --- CSRF / browser origins -------------------------------------------------
# Extra comma-separated browser origins allowed to send state-changing API
# requests, in addition to PUBLIC_SITE_URL. Must be https in production.
# Example: https://admin.buddhanews.com
ALLOWED_ORIGINS=
# Optional extra Host header values accepted by the reverse proxy / origin
# check (normally derived from PUBLIC_SITE_URL and ALLOWED_ORIGINS).
TRUSTED_HOSTS=

# --- Privacy-preserving identifiers ----------------------------------------
# Dedicated HMAC key for IP fingerprints and newsletter/view identifiers.
# Falls back to MANUS_JWT_SECRET with domain separation, but a separate value
# is recommended. Generate with: openssl rand -base64 48
PRIVACY_HASH_SECRET=

# --- Newsletter email delivery ---------------------------------------------
# Every message is written to `email_outbox` first and then delivered by the
# built-in worker (immediately, then every 60 s with exponential back-off).
# Configure ONE OR BOTH channels below; the webhook is tried first and SMTP is
# the fallback. With neither set, mail stays queued and the launch check
# reports a blocker (subscribers would never receive their confirmation link).
#
# Verified sender address on a domain with SPF + DKIM. Required for SMTP.
NEWSLETTER_FROM_EMAIL=
# Channel 1: HTTPS webhook. Receives POST JSON
#   {"to","from","subject","text","kind"} with `Authorization: Bearer <token>`.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Channel 2: SMTP. Either one URL (smtps://user:pass@smtp.example.com:465) ...
SMTP_URL=
# ... or the individual parts (used when SMTP_URL is empty):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true = implicit TLS (port 465). Leave false for STARTTLS on 587.
SMTP_SECURE=false
# Give up on a message after this many failed attempts (default 8). Queued
# messages older than 72 h are expired so a stale confirmation link is never sent.
EMAIL_MAX_ATTEMPTS=8
# Delete sent/failed outbox rows after this many days (default 30).
EMAIL_OUTBOX_RETENTION_DAYS=30
# Optional dedicated key for unsubscribe/confirmation tokens. Falls back to
# MANUS_JWT_SECRET with domain separation.
EMAIL_TOKEN_SECRET=

# --- Rate limits, AI budget and retention ----------------------------------
# Global AI guard (per IP, per user and per day). Defaults: 500 calls and
# 1,500,000 tokens per day.
AI_DAILY_CALL_LIMIT=500
AI_DAILY_TOKEN_LIMIT=1500000
# Data minimisation windows, enforced automatically once a day (see
# "Scheduler" below). The Privacy page promises ARTICLE_VIEW_RETENTION_DAYS, so
# keep it in sync with what you publish.
ARTICLE_VIEW_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
NEWSLETTER_PENDING_RETENTION_DAYS=14

# --- Scheduler (retention cleanup + outbox delivery) -------------------------
# The server runs retention cleanup daily and drains the mail outbox every
# minute. A database lock makes this safe with several instances: only one runs
# each cycle. Hours between cleanups (1-168, default 24):
CLEANUP_INTERVAL_HOURS=24
# Set to true when the platform runs `node dist/maintenance.js --mail` from its
# own cron (scale-to-zero hosts that sleep between requests need this).
DISABLE_INTERNAL_SCHEDULER=false

# --- Bot protection: Cloudflare Turnstile ----------------------------------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile, add
# your domain, and paste both keys. Both must be set to switch it on; the
# secret key never leaves the server. The contact and newsletter endpoints
# verify the token server-side and fail closed if Cloudflare is unreachable.
# The honeypot fields and per-IP rate limits are always on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting across several instances --------------------------------
# Without REDIS_URL, limits are counted per process (fine for ONE instance).
# With more than one instance (or serverless scale-out) set REDIS_URL so all
# instances share counters, and/or add the same limits at your CDN/WAF.
# Example: redis://:password@redis.internal:6379/0   (rediss:// for TLS)
REDIS_URL=
# Reverse-proxy hops in front of the app (Express "trust proxy"). Default 1.
# Use 2 for Cloudflare -> load balancer -> app. Wrong values let clients spoof IPs.
TRUST_PROXY=1
# Optional: trust a CDN-supplied header for the real client IP, e.g.
# CF-Connecting-IP (Cloudflare) or Fly-Client-IP. Only set it if the app is
# reachable ONLY through that CDN.
CLIENT_IP_HEADER=

# --- Public story cache -----------------------------------------------------
# Seconds to cache public story lists and "most read" in memory. Any create,
# edit, delete or restore clears it immediately. 0 disables (max 600).
PUBLIC_CACHE_TTL_SECONDS=30

# --- Account trust ----------------------------------------------------------
# When true, ADMIN_EMAILS / EDITOR_EMAILS only apply if the sign-in provider
# explicitly reports the email as verified. An account the provider marks as
# unverified is NEVER matched against the allow-lists, regardless of this flag.
# Leave false until you have confirmed your provider sends a verification claim
# (the Manus OAuth profile currently does not).
REQUIRE_VERIFIED_EMAIL=false

# --- Launch guard -----------------------------------------------------------
# Real newsroom address shown on Contact / Privacy / footer. Overrides the
# empty default; can also be set in Admin -> Settings -> contactEmail.
CONTACT_EMAIL=
# true = refuse to boot while launch BLOCKERS remain (demo contact address,
# no mail delivery, no admin, placeholder PUBLIC_SITE_URL). Warnings never block.
# Run `pnpm launch:check` (or `node dist/launch-check.js`) in CI to get the
# same report with exit code 1 on blockers.
ENFORCE_LAUNCH_CHECKS=false
# --- Content Security Policy ------------------------------------------------
# Comma-separated https image hosts allowed in addition to 'self', data: and
# blob:. Keep this list as small as possible.
CSP_IMAGE_HOSTS=
# Space-separated frame-ancestors sources. Default: 'none'.
FRAME_ANCESTORS='none'

# --- Runtime ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Seed the 14 clearly-labelled demonstration stories only on a fresh database.
SEED_ON_START=false
