{
  "name": "buddhanews",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts server/migrate.ts server/scripts/maintenance.ts server/scripts/launch-check.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --entry-names='[name]'",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "dev:static": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "build:static": "vite build",
    "db:seed": "tsx server/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "db:label-demo": "tsx server/scripts/label-demo.ts",
    "db:search-index": "tsx server/scripts/search-index.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "db:cleanup": "tsx server/scripts/maintenance.ts",
    "db:cleanup:prod": "node dist/maintenance.js",
    "launch:check": "tsx server/scripts/launch-check.ts",
    "launch:check:prod": "node dist/launch-check.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.25.2",
    "@trpc/react-query": "^11.25.2",
    "@trpc/server": "^11.25.2",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "marked": "^18.2.0",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "wouter": "^3.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/dompurify": "^3.2.0",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "pnpm": "10.18.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.18.0"
}
